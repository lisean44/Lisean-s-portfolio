{
  "name": "workspace",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev": "concurrently -n api,web -c blue,green \"npm --workspace apps/api run dev\" \"npm --workspace apps/web run dev\"",
    "build": "npm --workspace apps/api run build --if-present && npm --workspace apps/web run build",
    "test": "echo \"no tests\""
  },
